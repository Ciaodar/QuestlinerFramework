<?xml version="1.0" encoding="utf-8"?>
<Questline Id="QLF_DemirAhit_Cirak" Title="{=demirahit1_title}Çırağın Yemini" TimeLimitInDays="45">
  <TargetResolvers>
    <Resolver Alias="EfsaneviDemirci" TargetType="Hero" Filters="Artisan" Selector="Nearest" />
    <Resolver Alias="HammadeKaynagi" TargetType="Settlement" Filters="Village" Selector="Nearest" />
    <Resolver Alias="RakipTuccar" TargetType="Hero" Filters="Merchant" Selector="Random" />
  </TargetResolvers>

  <Prerequisites>
    <Condition Type="ClanTier" Amount="2" />
    <Condition Type="!GlobalFlag" ObjectId="DemirAhit_Baslatildi" Amount="1" />
  </Prerequisites>

  <Triggers>
    <Trigger EventType="AutoStart" />
  </Triggers>

  <Stages>
    <Stage Id="Stage1_Teklif" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false" TimeoutInDays="2">
      <LogText>{=da_log_1}{EfsaneviDemirci.Name} seni klanının efsanevi kılıcını dövmek için yanına çağırıyor. Ancak kılıç için {HammadeKaynagi_Link} civarında bulunan Yıldız Demiri'nden 5 adet bulman gerek.</LogText>
      <Conditions />
      <OnEnterActions>
        <Action Type="SetGlobalFlag" ObjectId="DemirAhit_Baslatildi" Amount="1" />
        <Action Type="SaveHeroToGlobal" TargetAlias="EfsaneviDemirci" StringValue="DemirAhit_AnaDemirci" />
        <Action Type="SaveHeroToGlobal" TargetAlias="RakipTuccar" StringValue="DemirAhit_RakipTuccar" />
      </OnEnterActions>
      <OnExitActions />
      <OnTimeoutActions>
        <Action Type="SpawnBanditParty" TargetAlias="KiralikKatiller" Amount="30" PartyTemplateId="sea_raiders_template" SpawnDistance="3" SpawnRadius="5" StringValue="{=da_katiller}Kiralık Katiller" />
        <Action Type="SetPartyAi" TargetAlias="KiralikKatiller" StringValue="EngageParty" ObjectId="Player" />
        <Action Type="ChangeStage" ObjectId="Stage2_Pusu" />
      </OnTimeoutActions>
    </Stage>

    <Stage Id="Stage2_Pusu" NextStageId="Stage2_Pusu_Zafer" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false" TimeoutInDays="1">
      <LogText>{=da_log_2}Madenleri toplarken Rakip Tüccar'ın kiraladığı haydutlar sana pusu kurdu! Onları yenmelisin.</LogText>
      <Conditions>
        <Condition Type="BattleResolvedAs" TargetAlias="KiralikKatiller" StringValue="Victory" />
      </Conditions>
      <OnEnterActions />
      <OnExitActions />
      <OnTimeoutActions>
         <Action Type="TakeItem" ObjectId="YildizDemiri" Amount="2" />
         <Action Type="DestroyParty" TargetAlias="KiralikKatiller" />
         <Action Type="ChangeStage" ObjectId="Stage1_Teklif" />
      </OnTimeoutActions>
    </Stage>

    <Stage Id="Stage2_Pusu_Zafer" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false">
      <LogText>{=da_log_2_win}Pusudaki haydutları temizledin. Artık görevine dönebilirsin.</LogText>
      <Conditions />
      <OnEnterActions>
         <Action Type="ChangeRelation" TargetAlias="RakipTuccar" Amount="-5" />
         <Action Type="ChangeStage" ObjectId="Stage1_Teklif" />
      </OnEnterActions>
      <OnExitActions />
      <OnTimeoutActions />
    </Stage>

    <Stage Id="Stage2_KestirmeYol" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="true" IsFailNode="false">
      <LogText>{=da_log_kestirme}Demirciyi ikna ederek kestirmeden kılıcı teslim aldın.</LogText>
      <Conditions />
      <OnEnterActions>
        <Action Type="GiveItem" ObjectId="GecicilAhitKilici" Amount="1" />
        <Action Type="ChangeRenown" Amount="25" />
        <Action Type="ChangeRelation" TargetAlias="EfsaneviDemirci" Amount="5" />
        <Action Type="SetGlobalFlag" ObjectId="DemirAhit1_Basarili" Amount="1" />
        <Action Type="CompleteQuest" />
      </OnEnterActions>
      <OnExitActions />
      <OnTimeoutActions />
    </Stage>

    <Stage Id="Stage3_Teslim" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false">
      <LogText>{=da_log_3}Yıldız Demirlerini topladın, artık bunları {EfsaneviDemirci.Name}'e teslim edebilirsin.</LogText>
      <Conditions />
      <OnEnterActions />
      <OnExitActions />
      <OnTimeoutActions>
        <Action Type="SetGlobalFlag" ObjectId="DemirAhit1_Basarisiz" Amount="1" />
        <Action Type="FailQuest" />
      </OnTimeoutActions>
    </Stage>
  </Stages>

  <CustomDialogs>
    <!-- Stage 1: Demirci ile konuşup görevi dinleme / kestirme yolu seçme -->
    <DialogNode Type="Npc" Id="Demirci_Teklif_Giris" TargetAlias="EfsaneviDemirci" InputToken="start" OutputToken="da_tek_secimler" Priority="200">
      <Text>{=da_tek_1}Klanının adı büyüyor evlat. Atalarının kılıcını ben dövmüştüm; şimdi senin için yenisini dövme vaktim geldi. Ama önce bana 5 adet Yıldız Demiri getir.</Text>
      <Conditions>
        <Condition Type="IsStageActive" ObjectId="Stage1_Teklif" />
        <Condition Type="!HasItem" ObjectId="YildizDemiri" Amount="5" />
      </Conditions>
    </DialogNode>

    <DialogNode Type="Player" Id="Demirci_Teklif_Bilgi" TargetAlias="EfsaneviDemirci" InputToken="da_tek_secimler" OutputToken="close_window">
      <Text>{=da_tek_p1}Nerede bulabilirim bu madeni?</Text>
      <Consequences>
        <Action Type="LeaveEncounter" />
      </Consequences>
    </DialogNode>

    <DialogNode Type="Player" Id="Demirci_Teklif_Kestirme" TargetAlias="EfsaneviDemirci" InputToken="da_tek_secimler" OutputToken="close_window">
      <Text>{=da_tek_p2}Bu kadar beklemeye vaktim yok, bana zaten dövülmüş bir kılıç ver.</Text>
      <Conditions>
         <Condition Type="SkillCheck" ObjectId="Charm" Amount="30" />
      </Conditions>
      <Consequences>
         <Action Type="ChangeStage" ObjectId="Stage2_KestirmeYol" />
         <Action Type="LeaveEncounter" />
      </Consequences>
    </DialogNode>

    <!-- Stage 1 -> 3 Gecis Dialogu -->
    <DialogNode Type="Npc" Id="Demirci_Teslim_Gecis" TargetAlias="EfsaneviDemirci" InputToken="start" OutputToken="da_teslim_gecis_1" Priority="200">
      <Text>{=da_teslim_ready}Gözlerim beni yanıltmıyor değil mi? Yıldız Demirlerini getirmişsin!</Text>
      <Conditions>
        <Condition Type="IsStageActive" ObjectId="Stage1_Teklif" />
        <Condition Type="HasItem" ObjectId="YildizDemiri" Amount="5" />
      </Conditions>
    </DialogNode>

    <DialogNode Type="Player" Id="Demirci_Teslim_Gecis_P" TargetAlias="EfsaneviDemirci" InputToken="da_teslim_gecis_1" OutputToken="close_window">
      <Text>{=da_teslim_p1}Evet usta, al bakalım.</Text>
      <Consequences>
        <Action Type="ChangeStage" ObjectId="Stage3_Teslim" />
      </Consequences>
    </DialogNode>

    <!-- Stage 3: Nihai Teslim Dialogu -->
    <DialogNode Type="Npc" Id="Demirci_Teslim_Son" TargetAlias="EfsaneviDemirci" InputToken="start" OutputToken="da_teslim_son_1" Priority="200">
      <Text>{=da_teslim_2}İşte bu! Şimdi ateş başına — kılıç şekil almaya başlıyor. Şimdilik bu kılıcı al, adın daha da duyulduğunda tekrar görüşeceğiz.</Text>
      <Conditions>
        <Condition Type="IsStageActive" ObjectId="Stage3_Teslim" />
      </Conditions>
    </DialogNode>

    <DialogNode Type="Player" Id="Demirci_Teslim_Son_P" TargetAlias="EfsaneviDemirci" InputToken="da_teslim_son_1" OutputToken="close_window">
      <Text>{=da_teslim_p2}Teşekkürler usta. Bekliyor olacağım.</Text>
      <Consequences>
        <Action Type="TakeItem" ObjectId="YildizDemiri" Amount="5" />
        <Action Type="GiveItem" ObjectId="GecicilAhitKilici" Amount="1" />
        <Action Type="ChangeRenown" Amount="50" />
        <Action Type="ChangeRelation" TargetAlias="EfsaneviDemirci" Amount="15" />
        <Action Type="SetGlobalFlag" ObjectId="DemirAhit1_Basarili" Amount="1" />
        <Action Type="CompleteQuest" />
        <Action Type="LeaveEncounter" />
      </Consequences>
    </DialogNode>
  </CustomDialogs>
</Questline>
