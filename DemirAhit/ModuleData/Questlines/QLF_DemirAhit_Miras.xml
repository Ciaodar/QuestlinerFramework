<?xml version="1.0" encoding="utf-8"?>
<Questline Id="QLF_DemirAhit_Miras" Title="{=demirahit4_title}Forging the Legacy" TimeLimitInDays="60">
  <TargetResolvers>
    <Resolver Alias="EfsaneviDemirci" TargetType="Hero" Filters="GlobalHero(DemirAhit_AnaDemirci)" Selector="Nearest" />
    <Resolver Alias="Kalan" TargetType="Hero" Filters="GlobalHero(DemirAhit_Kalan)" Selector="Nearest" />
    <Resolver Alias="IttifakKrali" TargetType="Hero" Filters="KingdomLeader, SameFactionAs(Player)" Selector="Nearest" IsOptional="true" />
  </TargetResolvers>

  <Prerequisites>
    <Condition Type="ClanTier" Amount="5" />
    <Condition Type="GlobalFlag" ObjectId="DemirAhit3_Basarili" Amount="1" />
    <Condition Type="!GlobalFlag" ObjectId="DemirAhit4_Baslatildi" Amount="1" />
  </Prerequisites>

  <Triggers>
    <Trigger EventType="AutoStart" />
  </Triggers>

  <Stages>
    <Stage Id="Stage1_Haber" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false" TimeoutInDays="0">
      <LogText>{=da_log_4_1}There's only one step left to complete the legendary sword. {EfsaneviDemirci_Link} expects you at his workshop.</LogText>
      <Conditions />
      <OnEnterActions>
        <Action Type="SetGlobalFlag" ObjectId="DemirAhit4_Baslatildi" Amount="1" />
      </OnEnterActions>
      <OnExitActions />
      <OnTimeoutActions />
    </Stage>

    <Stage Id="Stage2_Kaynak" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false" TimeoutInDays="0">
      <LogText>{=da_log_4_2}To finalize the sword's spirit, you need to deliver the 'Heart's Fire', which costs 50,000 gold.</LogText>
      <Conditions />
      <OnEnterActions />
      <OnExitActions />
      <OnTimeoutActions />
    </Stage>

    <Stage Id="Stage3_Sonuc" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false" TimeoutInDays="0">
      <LogText>{=da_log_4_3}The Covenant Sword is finally forged! Talk to {EfsaneviDemirci_Link} to decide who the sword will belong to.</LogText>
      <Conditions />
      <OnEnterActions />
      <OnExitActions />
      <OnTimeoutActions />
    </Stage>

    <Stage Id="Stage4_Miras" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="true" IsFailNode="false">
      <LogText>{=da_log_4_4}The Covenant Sword became your clan's eternal legacy. The power and glory of your clan spread across the whole realm!</LogText>
      <Conditions />
      <OnEnterActions>
        <Action Type="GiveItem" ObjectId="AhitKilici_Efsanevi" Amount="1" />
        <Action Type="ChangeRenown" Amount="150" />
        <Action Type="ChangeInfluence" Amount="200" />
        <Action Type="SetGlobalFlag" ObjectId="DemirAhit4_Basarili" Amount="1" />
        <Action Type="CompleteQuest" />
      </OnEnterActions>
      <OnExitActions />
    </Stage>

    <Stage Id="Stage4_Kral" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="true" IsFailNode="false">
      <LogText>{=da_log_4_5}You gifted the Covenant Sword to King {IttifakKrali_Link}. Your influence and reputation within the kingdom reached legendary proportions!</LogText>
      <Conditions />
      <OnEnterActions>
        <Action Type="ChangeRenown" Amount="50" />
        <Action Type="ChangeInfluence" Amount="500" />
        <Action Type="ChangeRelation" TargetAlias="IttifakKrali" Amount="50" />
        <Action Type="SetGlobalFlag" ObjectId="DemirAhit4_Basarili" Amount="1" />
        <Action Type="CompleteQuest" />
      </OnEnterActions>
      <OnExitActions />
    </Stage>
  </Stages>

  <CustomDialogs>
    <!-- Stage 1: Ilk Gorusme -->
    <DialogNode Type="Player" Id="Miras_Giris_P" TargetAlias="EfsaneviDemirci" InputToken="hero_main_options" OutputToken="da_miras_npc_1" Priority="200">
      <Text>{=da_miras_p_giris}You sent for me, master? Is the sword ready?</Text>
      <Conditions>
        <Condition Type="IsStageActive" ObjectId="Stage1_Haber" />
      </Conditions>
    </DialogNode>

    <DialogNode Type="Npc" Id="Miras_Giris" TargetAlias="EfsaneviDemirci" InputToken="da_miras_npc_1" OutputToken="da_miras_secimler" Priority="200">
      <Text>{=da_miras_dlg_1}Child, my brother {Kalan_Link} and I have been working for months. The steel is perfected. But to give it a soul we need the 'Heart's Fire', which costs 50,000 gold.</Text>
      <Conditions />
    </DialogNode>

    <DialogNode Type="Player" Id="Miras_Kabul" TargetAlias="EfsaneviDemirci" InputToken="da_miras_secimler" OutputToken="close_window">
      <Text>{=da_miras_p1}I will gather the necessary gold and resources and return.</Text>
      <Consequences>
        <Action Type="ChangeStage" ObjectId="Stage2_Kaynak" />
        <Action Type="LeaveEncounter" />
      </Consequences>
    </DialogNode>

    <!-- Stage 2: Altin Teslimati -->
    <DialogNode Type="Player" Id="Miras_Kaynak_Giris_P" TargetAlias="EfsaneviDemirci" InputToken="hero_main_options" OutputToken="da_miras_npc_2" Priority="200">
      <Text>{=da_miras_p_giris_2}Let's finish this sword.</Text>
      <Conditions>
        <Condition Type="IsStageActive" ObjectId="Stage2_Kaynak" />
      </Conditions>
    </DialogNode>

    <DialogNode Type="Npc" Id="Miras_Kaynak_Giris" TargetAlias="EfsaneviDemirci" InputToken="da_miras_npc_2" OutputToken="da_miras_kaynak_secimler" Priority="200">
      <Text>{=da_miras_dlg_2}Did you bring what's needed for the ritual fire?</Text>
      <Conditions />
    </DialogNode>

    <DialogNode Type="Player" Id="Miras_Kaynak_Ver" TargetAlias="EfsaneviDemirci" InputToken="da_miras_kaynak_secimler" OutputToken="da_miras_npc_3">
      <Text>{=da_miras_p2}Here is 50,000 gold. Finish the sword.</Text>
      <Conditions>
        <Condition Type="HasGold" Amount="50000" />
      </Conditions>
    </DialogNode>

    <DialogNode Type="Player" Id="Miras_Kaynak_Yok" TargetAlias="EfsaneviDemirci" InputToken="da_miras_kaynak_secimler" OutputToken="close_window">
      <Text>{=da_miras_p3}I haven't gathered enough resources yet.</Text>
      <Conditions>
        <Condition Type="!HasGold" Amount="50000" />
      </Conditions>
      <Consequences>
        <Action Type="LeaveEncounter" />
      </Consequences>
    </DialogNode>

    <DialogNode Type="Npc" Id="Miras_Kaynak_Bitis" TargetAlias="EfsaneviDemirci" InputToken="da_miras_npc_3" OutputToken="close_window">
      <Text>{=da_miras_dlg_3}The fire burns! Give me a few hours... (Anvil sounds rise and the sword is completed with a legendary glow) Our masterpiece is ready! Speak to me again to discuss its fate.</Text>
      <Consequences>
        <Action Type="TakeGold" Amount="50000" />
        <Action Type="GiveItem" ObjectId="KalbinAtesi" Amount="1" />
        <Action Type="TakeItem" ObjectId="KalbinAtesi" Amount="1" />
        <Action Type="ChangeStage" ObjectId="Stage3_Sonuc" />
        <Action Type="LeaveEncounter" />
      </Consequences>
    </DialogNode>

    <!-- Stage 3: Karar -->
    <DialogNode Type="Player" Id="Miras_Karar_Giris_P" TargetAlias="EfsaneviDemirci" InputToken="hero_main_options" OutputToken="da_miras_npc_4" Priority="200">
      <Text>{=da_miras_p_giris_3}What is the final matter we need to discuss?</Text>
      <Conditions>
        <Condition Type="IsStageActive" ObjectId="Stage3_Sonuc" />
      </Conditions>
    </DialogNode>

    <DialogNode Type="Npc" Id="Miras_Karar_Giris" TargetAlias="EfsaneviDemirci" InputToken="da_miras_npc_4" OutputToken="da_miras_karar_secimler" Priority="200">
      <Text>{=da_miras_dlg_4}The Covenant Sword... The most perfect steel I have forged to this day. Will you wield this power as your own clan's eternal legacy, or will you gift it to the king you serve?</Text>
      <Conditions />
    </DialogNode>

    <DialogNode Type="Player" Id="Miras_Karar_Klan" TargetAlias="EfsaneviDemirci" InputToken="da_miras_karar_secimler" OutputToken="close_window">
      <Text>{=da_miras_p4}This sword will be the symbol of the unshakable power of my lineage and my clan.</Text>
      <Consequences>
        <Action Type="ChangeStage" ObjectId="Stage4_Miras" />
        <Action Type="LeaveEncounter" />
      </Consequences>
    </DialogNode>

    <DialogNode Type="Player" Id="Miras_Karar_Kral" TargetAlias="EfsaneviDemirci" InputToken="da_miras_karar_secimler" OutputToken="close_window">
      <Text>{=da_miras_p5}I will present this unique sword to King {IttifakKrali_Link}. The glory of our kingdom will increase.</Text>
      <Conditions>
        <Condition Type="IsVassalOfTargetFaction" TargetAlias="IttifakKrali" Amount="1" />
      </Conditions>
      <Consequences>
        <Action Type="ChangeStage" ObjectId="Stage4_Kral" />
        <Action Type="LeaveEncounter" />
      </Consequences>
    </DialogNode>
  </CustomDialogs>
</Questline>
