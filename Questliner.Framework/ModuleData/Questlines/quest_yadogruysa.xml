<?xml version="1.0" encoding="utf-8"?>
<Questline Id="QLF_YaDogruysa" Title="Çapulcunun Sözü: Ya Doğruysa?" TimeLimitInDays="30">
  
  <Prerequisites>
    <Condition Type="ClanTier" Amount="2" />
  </Prerequisites>
  
  <TargetResolvers>
    <!-- GizemliSehir: Oyuncuya en yakın ikinci ŞEHİR (Town) -->
    <Resolver Alias="GizemliSehir" TargetType="Settlement" Filters="Town" Selector="SecondNearest" />
  </TargetResolvers>

  <Stages>
    <!-- Aşama 1: İstihbarat Arayışı -->
    <Stage Id="Stage1" NextStageId="StageSuccess" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false">
      <LogText>Çapulcularla karşılaştın ve birisi itibarının tehlikede olduğunu, gerçeği öğrenmek için {GizemliSehir_Link} şehrindeki berbere gitmen gerektiğini söyledi. Onları kılıçtan geçirmiş olsan da, içindeki şüphe tohumu yeşerdi. {GizemliSehir_Link} şehrindeki berberi bul ve 'Çapulcunun adı ne?' diye sor.</LogText>
      <Conditions />
      <OnEnterActions />
      <OnExitActions />
    </Stage>

    <!-- Aşama 2: Tamamlandı -->
    <Stage Id="StageSuccess" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="true" IsFailNode="false">
      <LogText>Berberi bulup ona 'Çapulcunun adı ne?' diye sordun. Sana hakkındaki iftiralardan bahsetti. Anavatanından eski bir dostun, onun da bulunduğu 'Çapulcu Güvercinler' isimli gizli kültten senin için yardım istemiş. Sana bir miktar para vererek 70 kişilik bir parti toplayıp yakınlardaki bir köyün büyüğünü bulmanı söylediler.</LogText>
      <Conditions />
      <OnEnterActions>
        <Action Type="StartQuest" ObjectId="QLF_AnavataninIhaneti" />
      </OnEnterActions>
      <OnExitActions />
    </Stage>
  </Stages>

  <CustomDialogs>
    <!-- 1. ÇAPULCU İLE KARŞILAŞMA (ÖN GÖRÜ DİYALOGLARI) -->
    <DialogNode Type="Npc" Id="Capulcu_Giris" TargetAlias="looters" InputToken="start" OutputToken="ql_prequel_player_1" Priority="200">
      <Text>{PlayerName}! Sonunda seni bulabildim. Çapulcu olmak gerçekten çok zormuş.</Text>
      <Conditions>
        <Condition Type="IsQuestActive" ObjectId="QLF_YaDogruysa" Amount="0" />
        <Condition Type="IsQuestActive" ObjectId="QLF_ItibarDersi" Amount="0" />
        <Condition Type="IsQuestCompleted" ObjectId="QLF_YaDogruysa" Amount="0" />
        <Condition Type="IsQuestCompleted" ObjectId="QLF_ItibarDersi" Amount="0" />
      </Conditions>
    </DialogNode>

    <DialogNode Type="Player" Id="B1_Sorgu" TargetAlias="looters" InputToken="ql_prequel_player_1" OutputToken="ql_capulcu_aciklama">
      <Text>Bu saçmalık da ne, adımı nereden biliyorsun onursuz pislik?!</Text>
    </DialogNode>

    <DialogNode Type="Npc" Id="A2_Aciklama" TargetAlias="looters" InputToken="ql_capulcu_aciklama" OutputToken="ql_prequel_choices">
      <Text>Dinle, bu alelade bir çapulcunun saçma bir kandırma denemesi değil tamam mı? İtibarın tehlikede. Anavatanından bir dostunun dostuyum. Eğer itibarına değer veriyorsan en yakın ikinci şehrin berberine git ve "Çapulcunun ismi ne?" diye sor. Sana istihbarat sağlayacak.</Text>
    </DialogNode>

    <!-- SEÇENEK 1: SAVAŞMAK -> Ya Doğruysa Görevi Başlar & Savaş'a Girilir -->
    <DialogNode Type="Player" Id="B3_Savas" TargetAlias="looters" InputToken="ql_prequel_choices" OutputToken="close_window">
      <Text>Acınası bir savaş taktiği. (Saldır)</Text>
      <Consequences>
        <Action Type="StartQuest" ObjectId="QLF_YaDogruysa" />
      </Consequences>
    </DialogNode>

    <!-- SEÇENEK 2: DİYALOĞA DEVAM ET -->
    <DialogNode Type="Player" Id="B2_IyiDeneme" TargetAlias="looters" InputToken="ql_prequel_choices" OutputToken="ql_capulcu_inanis">
      <Text>İyi deneme. Sende taktiksel bir cevher var.</Text>
    </DialogNode>

    <DialogNode Type="Npc" Id="A2_Inanis" TargetAlias="looters" InputToken="ql_capulcu_inanis" OutputToken="ql_prequel_subchoices">
      <Text>İnanıyorsun. Biliyordum!</Text>
    </DialogNode>

    <!-- SEÇENEK 2.1: SERBEST BIRAKMAK -> Çapulcudan İtibar Dersi Görevi Başlar & Savaş Engellenir -->
    <DialogNode Type="Player" Id="B3_Baris" TargetAlias="looters" InputToken="ql_prequel_subchoices" OutputToken="ql_capulcu_veda">
      <Text>Belki... Öyle ya da böyle kandırmaca tekniğine saygımdan sizi serbest bırakacağım.</Text>
      <Consequences>
        <Action Type="StartQuest" ObjectId="QLF_ItibarDersi" />
        <Action Type="LeaveEncounter" />
      </Consequences>
    </DialogNode>

    <DialogNode Type="Npc" Id="A3_Veda" TargetAlias="looters" InputToken="ql_capulcu_veda" OutputToken="close_window">
      <Text>Göreceğiz...</Text>
    </DialogNode>

    <!-- SEÇENEK 2.2: YİNE DE SAVAŞMAK -->
    <DialogNode Type="Player" Id="B3_Savas2" TargetAlias="looters" InputToken="ql_prequel_subchoices" OutputToken="close_window">
      <Text>Dökülen her söz önem arz eder. Yine de onursuz bir çapulcunun başı omzunun üstünde kalamaz! (Saldır)</Text>
      <Consequences>
        <Action Type="StartQuest" ObjectId="QLF_YaDogruysa" />
      </Consequences>
    </DialogNode>

    <!-- 2. BERBER İLE KONUŞMA (GÖREVİ BİTİREN KISIM) -->
    <DialogNode Type="Player" Id="Berber_Soru" SpeakerStringId="barber" RequiredSettlementAlias="GizemliSehir" InputToken="hero_main_options" OutputToken="ql_berber_itibar_a1" Priority="100">
      <Text>Çapulcunun ismi ne?</Text>
      <Conditions>
        <Condition Type="IsStageActive" ObjectId="Stage1" />
      </Conditions>
    </DialogNode>

    <DialogNode Type="Npc" Id="Berber_A1_Itibar" SpeakerStringId="barber" RequiredSettlementAlias="GizemliSehir" InputToken="ql_berber_itibar_a1" OutputToken="ql_berber_itibar_b1">
      <Text>Anubis. Çapulcular diyarın en kuşkulu kuşlarıdır. Ne istemiştin, yabancı?</Text>
    </DialogNode>

    <DialogNode Type="Player" Id="Berber_B1a_Itibar" SpeakerStringId="barber" RequiredSettlementAlias="GizemliSehir" InputToken="ql_berber_itibar_b1" OutputToken="ql_berber_itibar_a2">
      <Text>Konuştuğum gizemli çapulcu kılıklı adam itibarımın tehlikede olduğunu söyledi. Umarım beni alaya almıyorsunuzdur.</Text>
    </DialogNode>
    <DialogNode Type="Player" Id="Berber_B1b_Itibar" SpeakerStringId="barber" RequiredSettlementAlias="GizemliSehir" InputToken="ql_berber_itibar_b1" OutputToken="ql_berber_itibar_a2">
      <Text>Çapulcu bana itibarın tehlikede, dedi. Bu ne anlama geliyor?</Text>
    </DialogNode>

    <DialogNode Type="Npc" Id="Berber_A2_Itibar" SpeakerStringId="barber" RequiredSettlementAlias="GizemliSehir" InputToken="ql_berber_itibar_a2" OutputToken="ql_berber_itibar_b2">
      <Text>Ahh, {PlayerName}... Kuşkucu davranışın tabii ki çok haklı. Merak etme. Ona inanmak ve buraya gelmekle çok iyi ettin. Anavatanından bir dost bize ulaştı. Arkandan hain ilan edilebileceğin sözler yaymaya başladıklarından bahsetti.</Text>
    </DialogNode>

    <DialogNode Type="Player" Id="Berber_B2a_Itibar" SpeakerStringId="barber" RequiredSettlementAlias="GizemliSehir" InputToken="ql_berber_itibar_b2" OutputToken="ql_berber_itibar_a3">
      <Text>Siz de kimsiniz? Nasıl bir kült bu? Dümdüz ulak gönderemiyor muydu aptal herif? Ayrıca ben bu adamı tanımıyorum bile. Oyun oynamayı bırak.</Text>
    </DialogNode>
    <DialogNode Type="Player" Id="Berber_B2b_Itibar" SpeakerStringId="barber" RequiredSettlementAlias="GizemliSehir" InputToken="ql_berber_itibar_b2" OutputToken="ql_berber_itibar_a3">
      <Text>Siz mi? Gizli bir topluluk musunuz? Derdiniz nedir?</Text>
    </DialogNode>

    <DialogNode Type="Npc" Id="Berber_A3_Itibar" SpeakerStringId="barber" RequiredSettlementAlias="GizemliSehir" InputToken="ql_berber_itibar_a3" OutputToken="ql_berber_itibar_b3">
      <Text>Merak etme dost. Biz asırlardır görev yapan Çapulcu Güvercinleriz. Herhangi bir ulaktan daha hızlı, herhangi bir uşaktan daha güçlüyüz. Dostun bizlere çokça yardımda bulunmuş cevval bir adamdır. Sana kefil oldu ve seni bu komplodan kurtarmamızı istedi.</Text>
    </DialogNode>

    <DialogNode Type="Player" Id="Berber_B3_Itibar" SpeakerStringId="barber" RequiredSettlementAlias="GizemliSehir" InputToken="ql_berber_itibar_b3" OutputToken="ql_berber_itibar_a4">
      <Text>Benden ne istiyorsunuz?</Text>
    </DialogNode>

    <DialogNode Type="Npc" Id="Berber_A4_Itibar" SpeakerStringId="barber" RequiredSettlementAlias="GizemliSehir" InputToken="ql_berber_itibar_a4" OutputToken="ql_berber_itibar_b4">
      <Text>Samimiyetimizin göstergesi olarak sana bir miktar altın hediye ediyoruz. 70 kişi toplayıp en yakın köydeki köy büyüğünü bul.</Text>
    </DialogNode>

    <DialogNode Type="Player" Id="Berber_B4a_Itibar" SpeakerStringId="barber" RequiredSettlementAlias="GizemliSehir" InputToken="ql_berber_itibar_b4" OutputToken="ql_berber_itibar_a5">
      <Text>Paranızı istemem. 70 kişilik bölüğü oraya götürmeyi de biraz düşüneceğim.</Text>
      <Consequences>
        <Action Type="ChangeStage" ObjectId="StageSuccess" />
      </Consequences>
    </DialogNode>

    <DialogNode Type="Player" Id="Berber_B4b_Itibar" SpeakerStringId="barber" RequiredSettlementAlias="GizemliSehir" InputToken="ql_berber_itibar_b4" OutputToken="ql_berber_itibar_a5">
      <Text>Teşekkürler. Bu parayla o bölüğü toplayıp köy ağası ile görüşeceğim.</Text>
      <Consequences>
        <Action Type="AddGold" Amount="1000" />
        <Action Type="ChangeStage" ObjectId="StageSuccess" />
      </Consequences>
    </DialogNode>

    <DialogNode Type="Player" Id="Berber_B4c_Itibar" SpeakerStringId="barber" RequiredSettlementAlias="GizemliSehir" InputToken="ql_berber_itibar_b4" OutputToken="close_window">
      <Text>Bu saçmalıkla daha fazla ilgilenmiyorum. Eğlenecek başka birini bulun.</Text>
      <Consequences>
        <Action Type="FailQuest" />
      </Consequences>
    </DialogNode>

    <DialogNode Type="Npc" Id="Berber_A5_Itibar" SpeakerStringId="barber" RequiredSettlementAlias="GizemliSehir" InputToken="ql_berber_itibar_a5" OutputToken="close_window">
      <Text>Pekala, görüşmek üzere yavru güvercin...</Text>
    </DialogNode>
  </CustomDialogs>
</Questline>
