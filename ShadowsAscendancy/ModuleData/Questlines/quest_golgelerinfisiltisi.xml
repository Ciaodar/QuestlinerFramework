<?xml version="1.0" encoding="utf-8"?>
<Questline Id="QLF_GolgelerinFisiltisi" Title="{=shdw_q1_title}Whispers of the Shadows" TimeLimitInDays="45">
  <TargetResolvers>
    <Resolver Alias="HedefSehir" TargetType="Settlement" Filters="IsTown" Selector="Nearest" />
    <Resolver Alias="GorevVeren" TargetType="Hero" Filters="Merchant" RequiredSettlementAlias="HedefSehir" Selector="Random" />
    <Resolver Alias="KacakciLideri" TargetType="Hero" Filters="GangLeader" RequiredSettlementAlias="HedefSehir" Selector="Random" />
  </TargetResolvers>

  <Prerequisites>
    <Condition Type="ClanTier" Amount="2" />
  </Prerequisites>

  <Triggers>
    <Trigger EventType="OnSettlementEnter" TargetAlias="HedefSehir" />
  </Triggers>

  <Stages>
    <Stage Id="Stage1_TuccarDiyalog" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false">
      <LogText>{=shdw_q1_s1_log}Your clan's name has started to be heard around here. A merchant named {GorevVeren_Link} in {HedefSehir_Link} wants to see you. It seems their caravans have been mysteriously disappearing lately.</LogText>
      <Conditions />
      <OnEnterActions>
        <Action Type="ForceConversation" TargetAlias="GorevVeren" />
      </OnEnterActions>
    </Stage>

    <Stage Id="Stage2_Takip" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false">
      <LogText>{=shdw_q1_s2_log}You spoke with the merchant {GorevVeren_Link} and agreed to track down the bandits attacking their caravans. Find the Smuggler Caravan on the map and defeat them.</LogText>
      <Conditions>
        <Condition Type="DefeatedParties" TargetAlias="HedefKervan" Amount="1" />
      </Conditions>
      <OnExitActions>
        <Action Type="GiveItem" ObjectId="sifreli_defter" Amount="1" />
        <Action Type="ChangeStage" ObjectId="Stage3_Kanit" />
      </OnExitActions>
    </Stage>

    <Stage Id="Stage3_Kanit" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false">
      <LogText>{=shdw_q1_s3_log}You destroyed the caravan and obtained the Encrypted Ledger. Now you must head to the back alleys of {HedefSehir_Link} and confront the Gang Leader {KacakciLideri_Link}.</LogText>
      <Conditions />
    </Stage>

    <Stage Id="Stage4_Kavga" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false">
      <LogText>{=shdw_q1_s4a_log}You rejected the gang leader's bribe. You are fighting to completely wipe out the gang. Eliminate the remaining gang members.</LogText>
      <Conditions>
        <Condition Type="DefeatedParties" TargetAlias="CetePartisi" Amount="1" />
      </Conditions>
      <OnExitActions>
        <Action Type="AddGold" Amount="3000" />
        <Action Type="ChangeRelation" TargetAlias="GorevVeren" Amount="15" />
        <Action Type="ChangeRelation" TargetAlias="KacakciLideri" Amount="-30" />
        <Action Type="SetGlobalFlag" ObjectId="GolgelerinFisiltisi_KanunAdami" Amount="1" />
        <Action Type="ChangeStage" ObjectId="StageSuccess_Kanun" />
      </OnExitActions>
    </Stage>

    <Stage Id="Stage4_Ihanet" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false">
      <LogText>{=shdw_q1_s4b_log}You struck a deal with the gang leader {KacakciLideri_Link}. You took your first step into the dark side. Now, as promised, find the merchant {GorevVeren_Link}, speak with them, and finish the job.</LogText>
      <Conditions />
    </Stage>

    <Stage Id="Stage4_KorumalarlaSavas" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false">
      <LogText>{=shdw_q1_s4c_log}The merchant {GorevVeren_Link} unleashed their mercenaries to save their own life. Defeat them and finish off the merchant!</LogText>
      <Conditions>
        <Condition Type="DefeatedParties" TargetAlias="TuccarKorumalari" Amount="1" />
      </Conditions>
      <OnExitActions>
        <Action Type="KillHero" TargetAlias="GorevVeren" />
        <Action Type="AddGold" Amount="5000" />
        <Action Type="ChangeRelation" TargetAlias="KacakciLideri" Amount="20" />
        <Action Type="SetGlobalFlag" ObjectId="GolgelerinFisiltisi_KaranlikOrtak" Amount="1" />
        <Action Type="ChangeStage" ObjectId="StageSuccess_Suc" />
      </OnExitActions>
    </Stage>

    <Stage Id="StageSuccess_Kanun" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="true" IsFailNode="false">
      <LogText>{=shdw_q1_s5a_log}You ignored the whispers of the shadows and brought justice. The caravan routes are safer now, but the underworld has marked your name.</LogText>
      <Conditions />
    </Stage>

    <Stage Id="StageSuccess_Suc" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="true" IsFailNode="false">
      <LogText>{=shdw_q1_s5b_log}The gleam of gold covered the color of blood. You became a partner of the shadows. The merchant is dead, and the caravans are now under your protection (or threat).</LogText>
      <Conditions />
    </Stage>
  </Stages>

  <CustomDialogs>
    <!-- Aşama 1: Tüccarla İlk Görüşme -->
    <DialogNode Type="Player" Id="Tuccar_Giris" TargetAlias="GorevVeren" InputToken="start" OutputToken="ql_shdw_t1" Priority="200">
      <Text>{=shdw_q1_dlg1}How can I help you, merchant?</Text>
      <Conditions>
        <Condition Type="IsStageActive" ObjectId="Stage1_TuccarDiyalog" />
      </Conditions>
      <Consequences>
        <Action Type="MakeMet" TargetAlias="GorevVeren" />
      </Consequences>
    </DialogNode>

    <DialogNode Type="Npc" Id="Tuccar_Aciklama" TargetAlias="GorevVeren" InputToken="ql_shdw_t1" OutputToken="ql_shdw_t2">
      <Text>{=shdw_q1_dlg2}My caravans... Someone is attacking them! Bandits are stealing my goods, but this is no ordinary robbery; it's as if they know our routes. Please find them and finish them off.</Text>
    </DialogNode>

    <DialogNode Type="Player" Id="Tuccar_Kabul" TargetAlias="GorevVeren" InputToken="ql_shdw_t2" OutputToken="close_window">
      <Text>{=shdw_q1_dlg3}I'll track down your caravans. Have my gold ready.</Text>
      <Consequences>
        <Action Type="SpawnBanditParty" TargetAlias="HedefKervan" Amount="30" StringValue="{=shdw_q1_kervan}Smuggler Caravan" />
        <Action Type="SetPartyAi" TargetAlias="HedefKervan" StringValue="IgnoreAi" />
        <Action Type="ChangeStage" ObjectId="Stage2_Takip" />
      </Consequences>
    </DialogNode>

    <!-- Aşama 3: Çete Lideriyle Yüzleşme -->
    <DialogNode Type="Player" Id="Cete_Giris" TargetAlias="KacakciLideri" InputToken="start" OutputToken="ql_shdw_c1" Priority="200">
      <Text>{=shdw_q1_dlg4}I found the dogs plundering the caravans and seized this encrypted ledger. You're no common bandit, who is behind this?</Text>
      <Conditions>
        <Condition Type="IsStageActive" ObjectId="Stage3_Kanit" />
      </Conditions>
      <Consequences>
        <Action Type="MakeMet" TargetAlias="KacakciLideri" />
      </Consequences>
    </DialogNode>

    <DialogNode Type="Npc" Id="Cete_Aciklama" TargetAlias="KacakciLideri" InputToken="ql_shdw_c1" OutputToken="ql_shdw_c2">
      <Text>{=shdw_q1_dlg5}(Laughs) You're just a fool who only knows how to swing a sword. That ledger is mine, and the innocent man you think is a merchant is actually a greedy bastard who stopped paying us tribute to monopolize the market.</Text>
      <Consequences>
        <Action Type="TakeItem" ObjectId="sifreli_defter" Amount="1" />
      </Consequences>
    </DialogNode>

    <DialogNode Type="Npc" Id="Cete_Teklif" TargetAlias="KacakciLideri" InputToken="ql_shdw_c2" OutputToken="ql_shdw_c3">
      <Text>{=shdw_q1_dlg6}Instead of causing me so much trouble, let's make a deal. Eliminate that merchant, and I'll give you a cut. The city streets are ours, and you'll profit too.</Text>
    </DialogNode>

    <!-- Oyuncu Kararları -->
    <DialogNode Type="Player" Id="Cete_Karar_Kanun" TargetAlias="KacakciLideri" InputToken="ql_shdw_c3" OutputToken="close_window">
      <Text>{=shdw_q1_dlg7}You can't escape justice. Draw your sword!</Text>
      <Consequences>
        <Action Type="LeaveEncounter" />
        <Action Type="SpawnBanditParty" TargetAlias="CetePartisi" Amount="40" StringValue="{=shdw_q1_cetepartisi}Gang Members" />
        <Action Type="SetPartyAi" TargetAlias="CetePartisi" StringValue="EngageParty" ObjectId="Player" />
        <Action Type="ChangeStage" ObjectId="Stage4_Kavga" />
      </Consequences>
    </DialogNode>

    <DialogNode Type="Player" Id="Cete_Karar_Karanlik" TargetAlias="KacakciLideri" InputToken="ql_shdw_c3" OutputToken="close_window">
      <Text>{=shdw_q1_dlg8}Gold opens all doors. We have a deal.</Text>
      <Consequences>
        <Action Type="ChangeStage" ObjectId="Stage4_Ihanet" />
      </Consequences>
    </DialogNode>

    <!-- Aşama 4: Tüccara İhanet (Eğer oyuncu çete ile anlaştıysa) -->
    <DialogNode Type="Player" Id="Tuccar_Ihanet_Giris" TargetAlias="GorevVeren" InputToken="start" OutputToken="ql_shdw_t4" Priority="200">
      <Text>{=shdw_q1_dlg9}You will pay for your betrayal with your blood!</Text>
      <Conditions>
        <Condition Type="IsStageActive" ObjectId="Stage4_Ihanet" />
      </Conditions>
    </DialogNode>

    <DialogNode Type="Npc" Id="Tuccar_Ihanet_Yalvaris" TargetAlias="GorevVeren" InputToken="ql_shdw_t4" OutputToken="ql_shdw_t5">
      <Text>{=shdw_q1_dlg10}What betrayal? What are you talking about?! No, wait, guards!</Text>
    </DialogNode>

    <DialogNode Type="Player" Id="Tuccar_Ihanet_Saldiri" TargetAlias="GorevVeren" InputToken="ql_shdw_t5" OutputToken="close_window">
      <Text>{=shdw_q1_dlg11}Too late. Die!</Text>
      <Consequences>
        <Action Type="LeaveEncounter" />
        <Action Type="SpawnBanditParty" TargetAlias="TuccarKorumalari" Amount="20" StringValue="{=shdw_q1_korumalar}Merchant Guards" />
        <Action Type="SetPartyAi" TargetAlias="TuccarKorumalari" StringValue="EngageParty" ObjectId="Player" />
        <Action Type="ChangeStage" ObjectId="Stage4_KorumalarlaSavas" />
      </Consequences>
    </DialogNode>

  </CustomDialogs>
</Questline>
