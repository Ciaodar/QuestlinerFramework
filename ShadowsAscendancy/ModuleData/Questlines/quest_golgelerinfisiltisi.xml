<?xml version="1.0" encoding="utf-8"?>
<Questline Id="QLF_GolgelerinFisiltisi" Title="{=shdw_q1_title}Whispers of the Shadows" TimeLimitInDays="45">
  <TargetResolvers>
    <Resolver Alias="HedefSehir" TargetType="Settlement" Filters="IsTown" Selector="Nearest" />
    <Resolver Alias="GorevVeren" TargetType="Hero" Filters="Merchant" RequiredSettlementAlias="HedefSehir" Selector="Random" />
    <Resolver Alias="KacakciLideri" TargetType="Hero" Filters="GangLeader" RequiredSettlementAlias="HedefSehir" Selector="Random" />
  </TargetResolvers>

  <Prerequisites>
    <Condition Type="ClanTier" Amount="2" />
    <Condition Type="!GlobalFlag" ObjectId="GolgelerinFisiltisi_Bitti" Amount="1" />
  </Prerequisites>

  <Triggers>
    <Trigger EventType="OnSettlementEnter" TargetAlias="HedefSehir" />
  </Triggers>

  <Stages>
    <Stage Id="Stage1_TuccarDiyalog" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false">
      <LogText>{=shdw_q1_s1_log}Your clan's name has started to be heard around here. A merchant named {GorevVeren_Link} in {HedefSehir_Link} wants to see you. It seems their caravans have been mysteriously disappearing lately.</LogText>
      <Conditions />
      <OnEnterActions>
        <Action Type="ForceConversation" TargetAlias="GorevVeren" />
      </OnEnterActions>
    </Stage>

    <Stage Id="Stage2_Takip" NextStageId="Stage3_Kanit" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false">
      <LogText>{=shdw_q1_s2_log}You spoke with the merchant {GorevVeren_Link} and agreed to track down the bandits attacking their caravans. Find the Smuggler Caravan on the map and defeat them.</LogText>
      <Conditions>
        <Condition Type="DefeatedParties" TargetAlias="HedefKervan" Amount="1" />
      </Conditions>
      <OnExitActions>
        <Action Type="GiveItem" ObjectId="sifreli_defter" Amount="1" />
      </OnExitActions>
    </Stage>

    <Stage Id="Stage3_Kanit" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false">
      <LogText>{=shdw_q1_s3_log}You destroyed the caravan and obtained the Encrypted Ledger. Now you must head to the back alleys of {HedefSehir_Link} and confront the Gang Leader {KacakciLideri_Link}.</LogText>
      <Conditions />
    </Stage>

    <Stage Id="Stage4_PusuBekleyis" NextStageId="Stage5_PusuSavas" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false">
      <LogText>{=shdw_q1_s4_pusu_log}You defied the gang leader. They threatened you and warned that the outside of the city is dangerous. Be prepared for an ambush as soon as you leave the settlement.</LogText>
      <Conditions>
        <!-- NOTE: This requires the new Condition from the Framework Developer! -->
        <Condition Type="!IsPlayerInSettlement" />
      </Conditions>
      <OnExitActions>
        <Action Type="SpawnBanditParty" TargetAlias="CetePartisi" Amount="50" StringValue="{=shdw_q1_cetepartisi}Gang Members" />
        <Action Type="SetPartyAi" TargetAlias="CetePartisi" StringValue="EngageParty" ObjectId="Player" />
      </OnExitActions>
    </Stage>

    <Stage Id="Stage5_PusuSavas" NextStageId="StageSuccess_Kanun" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false">
      <LogText>{=shdw_q1_s5_savas_log}The gang's assassins have ambushed you outside the city! Defeat them to secure the merchant's routes.</LogText>
      <Conditions>
        <Condition Type="DefeatedParties" TargetAlias="CetePartisi" Amount="1" />
      </Conditions>
      <OnExitActions>
        <Action Type="AddGold" Amount="5000" />
        <Action Type="ChangeRelation" TargetAlias="GorevVeren" Amount="15" />
        <Action Type="ChangeRelation" TargetAlias="KacakciLideri" Amount="-30" />
        <Action Type="SetGlobalFlag" ObjectId="GolgelerinFisiltisi_KanunAdami" Amount="1" />
        <Action Type="SetGlobalFlag" ObjectId="GolgelerinFisiltisi_Bitti" Amount="1" />
      </OnExitActions>
    </Stage>

    <Stage Id="Stage4_TuccarSantaj" NextStageId="StageSuccess_Suc" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false">
      <LogText>{=shdw_q1_s4_santaj_log}You made a deal with the gang leader. Now go back to the merchant {GorevVeren_Link} and force them to pay tribute to the gang, while you take your own hefty cut.</LogText>
      <Conditions />
    </Stage>

    <Stage Id="StageSuccess_Kanun" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="true" IsFailNode="false">
      <LogText>{=shdw_q1_s5a_log}You ignored the whispers of the shadows and brought justice. The caravan routes are safer now, but the underworld has marked your name.</LogText>
      <Conditions />
    </Stage>

    <Stage Id="StageSuccess_Suc" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="true" IsFailNode="false">
      <LogText>{=shdw_q1_s5b_log}The gleam of gold covered the color of blood. You forced the merchant into submission and became a partner of the shadows. The underworld routes are now under your protection.</LogText>
      <Conditions />
    </Stage>
  </Stages>

  <CustomDialogs>
    <DialogNode Type="Player" Id="Tuccar_Giris" TargetAlias="GorevVeren" InputToken="start" OutputToken="ql_shdw_t1" Priority="200">
      <Text>{=shdw_q1_dlg1}How can I help you, merchant?</Text>
      <Conditions>
        <Condition Type="IsStageActive" ObjectId="Stage1_TuccarDiyalog" />
      </Conditions>
      <Consequences>
        <Action Type="MakeMet" TargetAlias="GorevVeren" />
      </Consequences>
    </DialogNode>

    <DialogNode Type="Npc" Id="Tuccar_Aciklama" TargetAlias="GorevVeren" InputToken="ql_shdw_t1" OutputToken="ql_shdw_t2">
      <Text>{=shdw_q1_dlg2}My caravans... Someone is attacking them! Bandits are stealing my goods, but this is no ordinary robbery; it's as if they know our routes. Please find them and finish them off.</Text>
    </DialogNode>

    <DialogNode Type="Player" Id="Tuccar_Kabul" TargetAlias="GorevVeren" InputToken="ql_shdw_t2" OutputToken="close_window">
      <Text>{=shdw_q1_dlg3}I'll track down your caravans. Have my gold ready.</Text>
      <Consequences>
        <Action Type="SpawnBanditParty" TargetAlias="HedefKervan" Amount="30" StringValue="{=shdw_q1_kervan}Smuggler Caravan" />
        <Action Type="SetPartyAi" TargetAlias="HedefKervan" StringValue="IgnoreAi" />
        <Action Type="ChangeStage" ObjectId="Stage2_Takip" />
      </Consequences>
    </DialogNode>

    <DialogNode Type="Player" Id="Cete_Giris" TargetAlias="KacakciLideri" InputToken="start" OutputToken="ql_shdw_c1" Priority="200">
      <Text>{=shdw_q1_dlg4}I found the dogs plundering the caravans and seized this encrypted ledger. You're no common bandit, who is behind this?</Text>
      <Conditions>
        <Condition Type="IsStageActive" ObjectId="Stage3_Kanit" />
      </Conditions>
      <Consequences>
        <Action Type="MakeMet" TargetAlias="KacakciLideri" />
      </Consequences>
    </DialogNode>

    <DialogNode Type="Npc" Id="Cete_Aciklama" TargetAlias="KacakciLideri" InputToken="ql_shdw_c1" OutputToken="ql_shdw_c2">
      <Text>{=shdw_q1_dlg5}(Laughs) You're just a fool who only knows how to swing a sword. That ledger is mine, and the innocent man you think is a merchant is actually a greedy bastard who stopped paying us tribute to monopolize the market.</Text>
      <Consequences>
        <Action Type="TakeItem" ObjectId="sifreli_defter" Amount="1" />
      </Consequences>
    </DialogNode>

    <DialogNode Type="Npc" Id="Cete_Teklif" TargetAlias="KacakciLideri" InputToken="ql_shdw_c2" OutputToken="ql_shdw_c3">
      <Text>{=shdw_q1_dlg6}Instead of causing me so much trouble, let's make a deal. Eliminate that merchant, and I'll give you a cut. The city streets are ours, and you'll profit too.</Text>
    </DialogNode>

    <DialogNode Type="Player" Id="Cete_Karar_Kanun" TargetAlias="KacakciLideri" InputToken="ql_shdw_c3" OutputToken="ql_shdw_c4_kanun">
      <Text>{=shdw_q1_dlg7}You can't escape justice. I will see you hang.</Text>
    </DialogNode>

    <DialogNode Type="Npc" Id="Cete_Tehdit" TargetAlias="KacakciLideri" InputToken="ql_shdw_c4_kanun" OutputToken="close_window">
      <Text>{=shdw_q1_dlg_tehdit}Is that so? The outside of the city can be very dangerous these days. Watch your back on the roads, fool.</Text>
      <Consequences>
        <Action Type="ChangeStage" ObjectId="Stage4_PusuBekleyis" />
      </Consequences>
    </DialogNode>

    <DialogNode Type="Player" Id="Cete_Karar_Karanlik" TargetAlias="KacakciLideri" InputToken="ql_shdw_c3" OutputToken="ql_shdw_c4_karanlik">
      <Text>{=shdw_q1_dlg8}I am a noble, I don't do dirty work like assassinations. But pay me a hefty cut, and I'll force the merchant to pay you your tribute.</Text>
    </DialogNode>

    <DialogNode Type="Npc" Id="Cete_Anlasma" TargetAlias="KacakciLideri" InputToken="ql_shdw_c4_karanlik" OutputToken="close_window">
      <Text>{=shdw_q1_dlg_anlasma}Now you are talking like a true noble. Go convince him to pay up, and the underworld routes will welcome you.</Text>
      <Consequences>
        <Action Type="ChangeStage" ObjectId="Stage4_TuccarSantaj" />
      </Consequences>
    </DialogNode>

    <DialogNode Type="Player" Id="Tuccar_Santaj_Giris" TargetAlias="GorevVeren" InputToken="start" OutputToken="ql_shdw_t4" Priority="200">
      <Text>{=shdw_q1_dlg9}Your hands are tied, merchant. Pay the gang their tribute and give me my cut, or I will let them butcher you.</Text>
      <Conditions>
        <Condition Type="IsStageActive" ObjectId="Stage4_TuccarSantaj" />
      </Conditions>
    </DialogNode>

    <DialogNode Type="Npc" Id="Tuccar_Santaj_Cevap" TargetAlias="GorevVeren" InputToken="ql_shdw_t4" OutputToken="close_window">
      <Text>{=shdw_q1_dlg10}You... you are worse than them! Fine, take the gold. I have no choice. Leave me alone!</Text>
      <Consequences>
        <Action Type="AddGold" Amount="10000" />
        <Action Type="ChangeRelation" TargetAlias="GorevVeren" Amount="-50" />
        <Action Type="ChangeRelation" TargetAlias="KacakciLideri" Amount="20" />
        <Action Type="SetGlobalFlag" ObjectId="GolgelerinFisiltisi_KaranlikOrtak" Amount="1" />
        <Action Type="SetGlobalFlag" ObjectId="GolgelerinFisiltisi_Bitti" Amount="1" />
        <Action Type="ChangeStage" ObjectId="StageSuccess_Suc" />
      </Consequences>
    </DialogNode>

    <!-- Haydut Pususu Diyaloğu -->
    <DialogNode Type="Player" Id="Pusu_Giris" TargetAlias="CetePartisi" InputToken="start" OutputToken="ql_shdw_pusu1" Priority="200">
      <Text>{=shdw_q1_dlg_pusu1}Who are you? Stand down!</Text>
      <Conditions>
        <Condition Type="IsStageActive" ObjectId="Stage5_PusuSavas" />
      </Conditions>
      <!-- We can target MobileParty with DialogNode! -->
    </DialogNode>

    <DialogNode Type="Npc" Id="Pusu_Cevap" TargetAlias="CetePartisi" InputToken="ql_shdw_pusu1" OutputToken="close_window">
      <Text>{=shdw_q1_dlg_pusu2}So you think crossing {KacakciLideri_Link} is a good idea? Prepare to die! We will send you and that talkative merchant to your ancestors!</Text>
    </DialogNode>

  </CustomDialogs>
</Questline>
