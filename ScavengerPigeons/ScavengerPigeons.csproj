<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <GameFolder Condition="Exists('D:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord')">D:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord</GameFolder>
    <GameFolder Condition="'$(GameFolder)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Mount &amp; Blade II Bannerlord</GameFolder>
    <ModuleName>ScavengerPigeons</ModuleName>
    <OutputModuleName>ScavengerPigeons</OutputModuleName>
    <SubModuleTemplatePath>$(ProjectDir)SubModule.xml</SubModuleTemplatePath>
  </PropertyGroup>

  <Target Name="UpdateVersion" BeforeTargets="PreBuildEvent">
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(ProjectDir)Build\UpdateVersion.ps1&quot; -BuildType Debug" />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <PropertyGroup>
      <ModuleFolder>$(GameFolder)\Modules\$(OutputModuleName)</ModuleFolder>
    </PropertyGroup>
    <ItemGroup>
      <ModuleData Include="$(ProjectDir)ModuleData\**\*.*" />
    </ItemGroup>
    
    <Copy SourceFiles="$(SubModuleTemplatePath)" DestinationFiles="$(ModuleFolder)\SubModule.xml" />
    <Copy SourceFiles="@(ModuleData)" DestinationFolder="$(ModuleFolder)\ModuleData\%(RecursiveDir)" />
    <Copy SourceFiles="$(TargetDir)$(TargetFileName)" DestinationFolder="$(ModuleFolder)\bin\Win64_Shipping_Client\" />
  </Target>
</Project>
