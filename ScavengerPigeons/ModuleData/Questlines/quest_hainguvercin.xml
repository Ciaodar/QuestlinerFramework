<?xml version="1.0" encoding="utf-8"?>
<Questline Id="QLF_HainGuvercin" Title="{=sp_hg_title}Traitor Pigeon" TimeLimitInDays="30">
  <Prerequisites>
    <Condition Type="!IsQuestCompleted" ObjectId="QLF_HainGuvercin" Amount="1" />
  </Prerequisites>

  <TargetResolvers>
    <Resolver Alias="looters" TargetType="MobileParty" Filters="BanditParty, Faction(looters)" Selector="Random" IsOptional="true" />
    <Resolver Alias="HainCapulcular" TargetType="MobileParty" Filters="BanditParty, Faction(looters)" Selector="Random" IsOptional="true" />
    <Resolver Alias="CapulcuElebasi" TargetType="MobileParty" Filters="BanditParty, Faction(looters)" Selector="Random" IsOptional="true" />
    <Resolver Alias="ArtisanTarget" TargetType="Hero" Filters="GlobalHero(SP_HainZanaatkar)" IsOptional="true" />
  </TargetResolvers>

  <Stages>
    <Stage Id="Stage0_Tahkikat" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false" TimeoutInDays="1">
      <LogText>{=sp_hg_s0_log}You suspected the assassination mission and started an investigation. You are waiting for reports from your scouts to locate the looter parties carrying out provocations in your name... (1 Day)</LogText>
      <Conditions />
      <OnEnterActions />
      <OnExitActions />
      <OnTimeoutActions>
        <Action Type="ChangeStage" ObjectId="Stage1_CapulcuAvla" />
      </OnTimeoutActions>
    </Stage>

    <Stage Id="Stage1_CapulcuAvla" NextStageId="Stage2_Bekleme" LogType="Progress" TargetAmount="3" IsSuccessNode="false" IsFailNode="false">
      <LogText>{=sp_hg_s1_log}You suspected the assassination mission and started investigating. You must find and defeat 3 different looter parties wandering around using the name {PlayerName}. The truth will be revealed when you interrogate their scouts.</LogText>
      <Conditions>
        <Condition Type="DefeatedParties" TargetAlias="looters" Amount="3" />
      </Conditions>
      <OnEnterActions />
      <OnExitActions />
    </Stage>

    <Stage Id="Stage2_Bekleme" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false" TimeoutInDays="1">
      <LogText>{=sp_hg_s2_log}You are interrogating the captured looters in isolation... Wait for them to break and reveal the location of their ringleader. (1 Day)</LogText>
      <Conditions />
      <OnEnterActions />
      <OnExitActions />
      <OnTimeoutActions>
        <Action Type="SpawnBanditParty" TargetAlias="HainCapulcular" Amount="5" PartyTemplateId="looters_template" SpawnDistance="5" SpawnRadius="8" StringValue="{=sp_hg_spawn1}Traitor Looters" />
        <Action Type="SetPartyAi" TargetAlias="HainCapulcular" StringValue="EngagePlayer" />
        <Action Type="ChangeStage" ObjectId="Stage3_EsirSorgu" />
      </OnTimeoutActions>
    </Stage>

    <Stage Id="Stage3_EsirSorgu" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false">
      <LogText>{=sp_hg_s3_log}It is time to interrogate the captives. You must go to the looter party {HainCapulcular_Link} and speak with them.</LogText>
      <Conditions />
      <OnEnterActions />
      <OnExitActions />
    </Stage>

    <Stage Id="Stage4_ElebasiBekleme" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false">
      <LogText>{=sp_hg_s4_log}The captives revealed the whereabouts of their ringleader. Confront {CapulcuElebasi_Link} to learn the truth behind the conspiracy.</LogText>
      <Conditions />
      <OnEnterActions />
      <OnExitActions />
    </Stage>

    <Stage Id="Stage5_Gercek" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="true" IsFailNode="false">
      <LogText>{=sp_hg_s5_log}You found out who the real traitor is. Now all you have to do is pledge your allegiance to the kingdom.</LogText>
      <Conditions />
      <OnEnterActions>
        <Action Type="ChangeOtherQuestStage" ObjectId="QLF_AnavataninIhaneti" TargetAlias="Stage4_Dost_Inandi" />
      </OnEnterActions>
      <OnExitActions />
    </Stage>
  </Stages>

  <CustomDialogs>
    <!-- Stage 3: Esir Sorgusu -->
    <DialogNode Type="Npc" Id="Esir_Giris" TargetAlias="HainCapulcular" InputToken="start" OutputToken="ql_esir_a1" Priority="200">
      <Text>{=sp_hg_dlg1}We were sent by a looter in the field. Release our friends, and we will bring the looter to speak the truth.</Text>
      <Conditions>
        <Condition Type="IsStageActive" ObjectId="Stage3_EsirSorgu" />
      </Conditions>
    </DialogNode>
    
    <DialogNode Type="Player" Id="Esir_P1" TargetAlias="HainCapulcular" InputToken="ql_esir_a1" OutputToken="ql_esir_a2">
      <Text>{=sp_hg_dlg2}Tell me what you know, or I will put you all to the sword!</Text>
    </DialogNode>
    
    <DialogNode Type="Npc" Id="Esir_N2" TargetAlias="HainCapulcular" InputToken="ql_esir_a2" OutputToken="ql_esir_p2">
      <Text>{=sp_hg_dlg3}We are just field operatives. The artisan tells us who to target. But the real boss will be here soon. Let us bring him to you!</Text>
    </DialogNode>
    
    <DialogNode Type="Player" Id="Esir_P2" TargetAlias="HainCapulcular" InputToken="ql_esir_p2" OutputToken="close_window">
      <Text>{=sp_hg_dlg4}Alright, I'm letting you go. You're of no other use anyway. I'll be waiting for your ringleader.</Text>
      <Consequences>
        <Action Type="SpawnBanditParty" TargetAlias="CapulcuElebasi" Amount="25" PartyTemplateId="looters_template" SpawnDistance="6" SpawnRadius="9" StringValue="{=sp_hg_spawn2}Looter Ringleader" />
        <Action Type="SetPartyAi" TargetAlias="CapulcuElebasi" StringValue="EngagePlayer" />
        <Action Type="ChangeStage" ObjectId="Stage4_ElebasiBekleme" />
        <Action Type="DestroyEncounteredParty" />
        <Action Type="LeaveEncounter" />
      </Consequences>
    </DialogNode>

    <!-- Stage 4: Elebaşı Konusmasi -->
    <DialogNode Type="Npc" Id="Elebasi_Giris" TargetAlias="CapulcuElebasi" InputToken="start" OutputToken="ql_elebasi_a1" Priority="200">
      <Text>{=sp_hg_dlg5}Halt! We are not here to draw swords... You released my soldiers. I am a looter field coordinator. What is the meaning of this? Are you trying to tell us something?</Text>
      <Conditions>
        <Condition Type="IsStageActive" ObjectId="Stage4_ElebasiBekleme" />
      </Conditions>
    </DialogNode>
    
    <DialogNode Type="Player" Id="Elebasi_P1" TargetAlias="CapulcuElebasi" InputToken="ql_elebasi_a1" OutputToken="ql_elebasi_a2">
      <Text>{=sp_hg_dlg6}Yes, I stand before you to prove I didn't kill the man we call our friend. I need to find out who started these slanderous rumors.</Text>
    </DialogNode>
    <DialogNode Type="Player" Id="Elebasi_P2" TargetAlias="CapulcuElebasi" InputToken="ql_elebasi_a1" OutputToken="ql_elebasi_a2">
      <Text>{=sp_hg_dlg7}No, I have no more business with you looters. I wasn't going to execute someone I don't even know for you.</Text>
    </DialogNode>

    <DialogNode Type="Npc" Id="Elebasi_N2" TargetAlias="CapulcuElebasi" InputToken="ql_elebasi_a2" OutputToken="ql_elebasi_step2_choices">
      <Text>{=sp_hg_dlg8}Kill? Then you are not the traitor among us... The real traitor is that rabid dog {ArtisanTarget_Link} who gave you the order. Your true mission should have been to return to the Motherland and offer your services.</Text>
    </DialogNode>

    <DialogNode Type="Player" Id="Elebasi_P2_Inq" TargetAlias="CapulcuElebasi" InputToken="ql_elebasi_step2_choices" OutputToken="ql_elebasi_a3">
      <Text>{=sp_hg_dlg_p2_inq}So the assassination was never an official order from the realm? I was merely a pawn in his power struggle?</Text>
    </DialogNode>
    <DialogNode Type="Player" Id="Elebasi_P2_Prag" TargetAlias="CapulcuElebasi" InputToken="ql_elebasi_step2_choices" OutputToken="ql_elebasi_a3">
      <Text>{=sp_hg_dlg_p2_prag}I knew something smelled foul. The artisan will pay for trying to deceive me.</Text>
    </DialogNode>
    
    <DialogNode Type="Npc" Id="Elebasi_N3" TargetAlias="CapulcuElebasi" InputToken="ql_elebasi_a3" OutputToken="close_window">
      <Text>{=sp_hg_dlg9}You passed an unexpected test, pigeon. You've more than proven your reliability. Farewell.</Text>
      <Consequences>
        <Action Type="DestroyEncounteredParty" />
        <Action Type="LeaveEncounter" />
        <Action Type="ChangeStage" ObjectId="Stage5_Gercek" />
      </Consequences>
    </DialogNode>
  </CustomDialogs>
</Questline>