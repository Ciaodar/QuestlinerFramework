<?xml version="1.0" encoding="utf-8"?>
<Questline Id="QLF_GolgeTunegi_Cagri" Title="{=sp_gt1_title}Call of the Shadow Roost" TimeLimitInDays="45">

  <Prerequisites>
    <Condition Type="GlobalFlag" ObjectId="SP_DerinKanat_Dinlendi" Amount="1" />
  </Prerequisites>

  <Triggers>
    <Trigger EventType="AutoStart" />
  </Triggers>

  <TargetResolvers>
    <Resolver Alias="Dost" TargetType="Hero" Filters="GlobalHero(SP_Dost)" IsOptional="true" />
    <Resolver Alias="GolgeSehri" TargetType="Settlement" Filters="Town" Selector="Nearest" />
    <Resolver Alias="GolgeUlagi" TargetType="Hero" Filters="Artisan" RequiredSettlementAlias="GolgeSehri" />
    <Resolver Alias="GolgeSiginagi" TargetType="Settlement" Filters="Hideout" Selector="Nearest" />
    <Resolver Alias="RakipAjanlar" TargetType="MobileParty" Filters="BanditParty" Selector="Random" IsOptional="true" />
  </TargetResolvers>

  <Stages>
    <Stage Id="Stage0_Soguma" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false" TimeoutInDays="1">
      <LogText>{=sp_gt1_s0_log}You spared the deep wing courier and chose to heed his warnings of Dost's false wars. With Dost's suspicion aroused, you must lay low and blend into the shadows. Wait for the heat to die down... (1 Day)</LogText>
      <Conditions />
      <OnTimeoutActions>
        <Action Type="ChangeStage" ObjectId="Stage1_UlakBulusma" />
      </OnTimeoutActions>
    </Stage>

    <Stage Id="Stage1_UlakBulusma" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false">
      <LogText>{=sp_gt1_s1_log}A black pigeon landed under your cloak, bearing word that the Shadow Roost recognizes your defiance of Dost's false wars. Travel to {GolgeSehri_Link} and speak with the Shadow Courier {GolgeUlagi_Link}.</LogText>
      <Conditions />
      <OnEnterActions>
        <Action Type="MakeMet" TargetAlias="GolgeUlagi" />
      </OnEnterActions>
    </Stage>

    <Stage Id="Stage2_AjanBaskini" NextStageId="StageSuccess" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false">
      <LogText>{=sp_gt1_s2_log}The courier confirmed Dost's fabrications. Prove your resolve for the Shadow Council: Ambush and eliminate the 50-man foreign detachment {RakipAjanlar_Link} awaiting leaked dispatches near {GolgeSiginagi_Link}.</LogText>
      <Conditions>
        <Condition Type="DefeatedParties" TargetAlias="RakipAjanlar" Amount="1" />
      </Conditions>
    </Stage>

    <Stage Id="StageSuccess" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="true" IsFailNode="false">
      <LogText>{=sp_gt1_s_success_log}You destroyed the foreign detachment. The Shadow Roost approved your lethality and determination. You are no longer a blind pawn of Dost; you are an initiate of the shadows. You received the 'Shadow Bone Dagger' and 30,000 denars.</LogText>
      <Conditions />
      <OnEnterActions>
        <Action Type="GiveItem" ObjectId="shadow_bone_dagger" Amount="1" />
        <Action Type="AddGold" Amount="30000" />
        <Action Type="ChangeRenown" Amount="40" />
        <Action Type="StartQuest" ObjectId="QLF_GolgeTunegi_Tasfiye" />
      </OnEnterActions>
    </Stage>
  </Stages>

  <CustomDialogs>
    <!-- Golge Ulagi ile Bulusma: Cok Adimli & Rol Yapma Secenekleri -->
    <DialogNode Type="Npc" Id="GT1_Ulak_Giris_Npc" TargetAlias="GolgeUlagi" InputToken="start" OutputToken="ql_gt1_ulak_1" Priority="200">
      <Text>{=sp_gt1_dlg1}You spared the courier who ordered Dost's execution... The Shadow Roost watched your choice closely.</Text>
      <Conditions>
        <Condition Type="IsStageActive" ObjectId="Stage1_UlakBulusma" />
      </Conditions>
    </DialogNode>

    <DialogNode Type="Player" Id="GT1_Ulak_Giris_Player" TargetAlias="GolgeUlagi" InputToken="hero_main_options" OutputToken="ql_gt1_ulak_1" Priority="200">
      <Text>{=sp_gt1_dlg1_p}I was guided here by a black pigeon after sparing the inner courier.</Text>
      <Conditions>
        <Condition Type="IsStageActive" ObjectId="Stage1_UlakBulusma" />
      </Conditions>
    </DialogNode>

    <DialogNode Type="Npc" Id="GT1_Ulak_Branch1" TargetAlias="GolgeUlagi" InputToken="ql_gt1_ulak_1" OutputToken="ql_gt1_ulak_step1_choices">
      <Text>{=sp_gt1_dlg2}Dost has corrupted the Scavenger Pigeons. He manufactures fake border skirmishes and trades secret dispatches to foreign kingdoms to enrich his cabal. But the Shadow Roost will not admit a novice without proof of cold resolve. A 50-man foreign detachment waits near {GolgeSiginagi_Link} to purchase his latest intelligence. Slay them all. Leave no tongue to tell the tale.</Text>
    </DialogNode>

    <!-- Adım 2: Oyuncu Yanıtı (3 Farklı Rol Yapma Tonu + Erteleme) -->
    <DialogNode Type="Player" Id="GT1_Ulak_Choice_Resolute" TargetAlias="GolgeUlagi" InputToken="ql_gt1_ulak_step1_choices" OutputToken="close_window">
      <Text>{=sp_gt1_dlg3}Dost's lies end now. Their blood will water the mountain. (Accept Mission)</Text>
      <Consequences>
        <Action Type="SpawnBanditParty" TargetAlias="RakipAjanlar" Amount="50" PartyTemplateId="deserters_template" ObjectId="GolgeSiginagi" StringValue="Hold" />
        <Action Type="SetPartyAi" TargetAlias="RakipAjanlar" StringValue="Hold" />
        <Action Type="ChangeStage" ObjectId="Stage2_AjanBaskini" />
      </Consequences>
    </DialogNode>

    <DialogNode Type="Player" Id="GT1_Ulak_Choice_Pragmatic" TargetAlias="GolgeUlagi" InputToken="ql_gt1_ulak_step1_choices" OutputToken="close_window">
      <Text>{=sp_gt1_dlg3_prag}Fifty foreign deserters will fall beneath my steel. The Shadow Roost better have gold ready when I return. (Accept Mission)</Text>
      <Consequences>
        <Action Type="SpawnBanditParty" TargetAlias="RakipAjanlar" Amount="50" PartyTemplateId="deserters_template" ObjectId="GolgeSiginagi" StringValue="Hold" />
        <Action Type="SetPartyAi" TargetAlias="RakipAjanlar" StringValue="Hold" />
        <Action Type="ChangeStage" ObjectId="Stage2_AjanBaskini" />
      </Consequences>
    </DialogNode>

    <DialogNode Type="Player" Id="GT1_Ulak_Choice_Inquisitive" TargetAlias="GolgeUlagi" InputToken="ql_gt1_ulak_step1_choices" OutputToken="close_window">
      <Text>{=sp_gt1_dlg3_inq}If Dost is trading with foreign powers, destroying this detachment will strike at his core. I will ride immediately. (Accept Mission)</Text>
      <Consequences>
        <Action Type="SpawnBanditParty" TargetAlias="RakipAjanlar" Amount="50" PartyTemplateId="deserters_template" ObjectId="GolgeSiginagi" StringValue="Hold" />
        <Action Type="SetPartyAi" TargetAlias="RakipAjanlar" StringValue="Hold" />
        <Action Type="ChangeStage" ObjectId="Stage2_AjanBaskini" />
      </Consequences>
    </DialogNode>

    <DialogNode Type="Player" Id="GT1_Ulak_Choice_Ertele" TargetAlias="GolgeUlagi" InputToken="ql_gt1_ulak_step1_choices" OutputToken="close_window">
      <Text>{=sp_gt1_ertele}I cannot deal with this right now. We will speak later.</Text>
    </DialogNode>
  </CustomDialogs>
</Questline>
