<?xml version="1.0" encoding="utf-8"?>
<Questline Id="QLF_GolgeTunegi_Tasfiye" Title="{=sp_gt2_title}Blood Ciphers &amp; The Great Purge" TimeLimitInDays="60">

  <Prerequisites>
    <Condition Type="IsQuestCompleted" ObjectId="QLF_GolgeTunegi_Cagri" Amount="1" />
    <Condition Type="!IsQuestCompleted" ObjectId="QLF_GolgeTunegi_Tasfiye" Amount="1" />
  </Prerequisites>

  <Triggers>
    <Trigger EventType="AutoStart" />
  </Triggers>

  <TargetResolvers>
    <Resolver Alias="Dost" TargetType="Hero" Filters="GlobalHero(SP_Dost)" />
    <Resolver Alias="Muhbir1" TargetType="Hero" Filters="Merchant, SameKingdomAs(Dost)" Selector="Nearest" />
    <Resolver Alias="Muhbir2" TargetType="Hero" Filters="GangLeader, SameKingdomAs(Dost)" Selector="Random" />
    <Resolver Alias="DostOrdusu" TargetType="MobileParty" Filters="LordParty, PartyOf(Dost)" Selector="NearestTo(Dost)" IsOptional="true" />
    <Resolver Alias="CeteMuhafizlari" TargetType="MobileParty" Filters="BanditParty" Selector="Random" IsOptional="true" />
  </TargetResolvers>

  <Stages>
    <Stage Id="Stage1_Muhbir1" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false">
      <LogText>{=sp_gt2_s1_log}The Shadow Roost demands all compromised channels severed. Track down the merchant informant {Muhbir1_Link} who funded {Dost_Name}'s black market network and silence him forever.</LogText>
      <Conditions />
      <OnEnterActions>
        <Action Type="MakeMet" TargetAlias="Muhbir1" />
      </OnEnterActions>
    </Stage>

    <Stage Id="Stage2_Muhbir2" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false">
      <LogText>{=sp_gt2_s2_log}{Muhbir1_Link} will speak no more. Now seek out the underworld gang leader {Muhbir2_Link} in the slums and eliminate him and his cutthroats.</LogText>
      <Conditions />
      <OnEnterActions>
        <Action Type="MakeMet" TargetAlias="Muhbir2" />
      </OnEnterActions>
    </Stage>

    <Stage Id="Stage2_CeteSavasi" NextStageId="Stage3_DostYuzlesme" FailStageId="StageFail_CeteDefeat" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false">
      <LogText>{=sp_gt2_s2_fight_log}{Muhbir2_Link}'s 30 mercenary enforcers ({CeteMuhafizlari_Link}) have ambushed you in the back streets! Cut through them to complete the underworld purge.</LogText>
      <Conditions>
        <Condition Type="DefeatedParties" TargetAlias="CeteMuhafizlari" Amount="1" />
      </Conditions>
      <FailConditions>
        <Condition Type="BattleResolvedAs" TargetAlias="CeteMuhafizlari" StringValue="Defeat" />
      </FailConditions>
      <OnExitActions>
        <Action Type="MakeMet" TargetAlias="Dost" />
      </OnExitActions>
    </Stage>

    <Stage Id="StageFail_CeteDefeat" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="true">
      <LogText>{=sp_gt2_fail_cete_log}The underworld thugs overwhelmed your forces in the back alleys. The purge of the conspirators fell apart in chaos.</LogText>
      <Conditions />
      <OnEnterActions>
        <Action Type="DestroyParty" TargetAlias="CeteMuhafizlari" />
        <Action Type="ShowInquiry" Title="{=sp_gt2_inq_defeat_title}Purge Ambush Defeat" Text="{=sp_gt2_fail_cete_log}The underworld thugs overwhelmed your forces in the back alleys. The purge of the conspirators fell apart in chaos." AffirmativeText="{=sp_btn_bitter}A bitter defeat" />
      </OnEnterActions>
    </Stage>

    <Stage Id="Stage3_DostYuzlesme" NextStageId="StageSuccess" LogType="Simple" TargetAmount="1" IsSuccessNode="false" IsFailNode="false">
      <LogText>{=sp_gt2_s3_log}Your former ally {Dost_Link} has raised an army ({DostOrdusu_Link}) to hunt you down as a rogue conspirator. Confront his host on the battlefield and finish this!</LogText>
      <Conditions>
        <Condition Type="DefeatedParties" TargetAlias="DostOrdusu" Amount="1" />
      </Conditions>
      <OnEnterActions>
        <Action Type="MakeMet" TargetAlias="Dost" />
      </OnEnterActions>
    </Stage>

    <Stage Id="StageSuccess" NextStageId="" LogType="Simple" TargetAmount="1" IsSuccessNode="true" IsFailNode="false">
      <LogText>{=sp_gt2_s_success_log}You broke {Dost_Name}'s army and executed him on the field of honor. The false patriot is dead. The Shadow Roost sends you 50,000 denars and 50 renown, inviting you to the final council.</LogText>
      <Conditions />
      <OnEnterActions>
        <Action Type="KillHero" TargetAlias="Dost" />
        <Action Type="SetGlobalFlag" ObjectId="SP_Dost_Ortadan_Kalkti" Amount="1" />
        <Action Type="AddGold" Amount="50000" />
        <Action Type="ChangeRenown" Amount="50" />
        <Action Type="StartQuest" ObjectId="QLF_GolgeTunegi_NihaiSon" />
      </OnEnterActions>
    </Stage>
  </Stages>

  <CustomDialogs>
    <!-- Muhbir 1 (Tuccar) Diyaloglari -->
    <DialogNode Type="Npc" Id="GT2_M1_Npc" TargetAlias="Muhbir1" InputToken="start" OutputToken="ql_gt2_m1_intro" Priority="200">
      <Text>{=sp_gt2_dlg1}You... You are that phantom from the Shadow Roost! What do you want from me? I burned all the ledgers, I swear it!</Text>
      <Conditions>
        <Condition Type="IsStageActive" ObjectId="Stage1_Muhbir1" />
      </Conditions>
    </DialogNode>

    <DialogNode Type="Player" Id="GT2_M1_Player" TargetAlias="Muhbir1" InputToken="hero_main_options" OutputToken="ql_gt2_m1_player_intro" Priority="200">
      <Text>{=sp_gt2_dlg1_p}I am here regarding the ciphers you purchased.</Text>
      <Conditions>
        <Condition Type="IsStageActive" ObjectId="Stage1_Muhbir1" />
      </Conditions>
    </DialogNode>

    <DialogNode Type="Npc" Id="GT2_M1_Npc_Reply" TargetAlias="Muhbir1" InputToken="ql_gt2_m1_player_intro" OutputToken="ql_gt2_m1_intro">
      <Text>{=sp_gt2_dlg1_reply}What?! Who sent you?! Was it the courier cabal?! Please, I burned all the ledgers, take anything you want, spare my life!</Text>
    </DialogNode>

    <DialogNode Type="Player" Id="GT2_M1_ChoiceA" TargetAlias="Muhbir1" InputToken="ql_gt2_m1_intro" OutputToken="close_window">
      <Text>{=sp_gt2_dlg2}The Shadow Roost knows no mercy. Silence is your only fate. (Execute the Merchant)</Text>
      <Consequences>
        <Action Type="KillHero" TargetAlias="Muhbir1" />
        <Action Type="ChangeStage" ObjectId="Stage2_Muhbir2" />
      </Consequences>
    </DialogNode>

    <DialogNode Type="Player" Id="GT2_M1_ChoiceB" TargetAlias="Muhbir1" InputToken="ql_gt2_m1_intro" OutputToken="close_window">
      <Text>{=sp_gt2_dlg3}Hand over the vault keys first, then face your doom. (Extort 15,000 denars &amp; Execute)</Text>
      <Consequences>
        <Action Type="AddGold" Amount="15000" />
        <Action Type="KillHero" TargetAlias="Muhbir1" />
        <Action Type="ChangeStage" ObjectId="Stage2_Muhbir2" />
      </Consequences>
    </DialogNode>

    <DialogNode Type="Player" Id="GT2_M1_Choice_Ertele" TargetAlias="Muhbir1" InputToken="ql_gt2_m1_intro" OutputToken="close_window">
      <Text>{=sp_gt2_ertele}I cannot deal with this right now. We will speak later.</Text>
    </DialogNode>

    <!-- Muhbir 2 (Cete Lideri) Diyaloglari -->
    <DialogNode Type="Npc" Id="GT2_M2_Npc" TargetAlias="Muhbir2" InputToken="start" OutputToken="ql_gt2_m2_intro" Priority="200">
      <Text>{=sp_gt2_dlg4}You think you can purge the alleys, Pigeon? You murdered the merchant, but you won't leave this den breathing! Boys, gut this dog!</Text>
      <Conditions>
        <Condition Type="IsStageActive" ObjectId="Stage2_Muhbir2" />
      </Conditions>
    </DialogNode>

    <DialogNode Type="Player" Id="GT2_M2_Player" TargetAlias="Muhbir2" InputToken="hero_main_options" OutputToken="ql_gt2_m2_player_intro" Priority="200">
      <Text>{=sp_gt2_dlg4_p}The Shadow Roost requires your silence, gang master.</Text>
      <Conditions>
        <Condition Type="IsStageActive" ObjectId="Stage2_Muhbir2" />
      </Conditions>
    </DialogNode>

    <DialogNode Type="Npc" Id="GT2_M2_Npc_Reply" TargetAlias="Muhbir2" InputToken="ql_gt2_m2_player_intro" OutputToken="ql_gt2_m2_intro">
      <Text>{=sp_gt2_dlg4_reply}My silence? The only silence you will find in this alley is six feet under! Boys, carve this wretch up!</Text>
    </DialogNode>

    <DialogNode Type="Player" Id="GT2_M2_Choice_Fight" TargetAlias="Muhbir2" InputToken="ql_gt2_m2_intro" OutputToken="close_window">
      <Text>{=sp_gt2_dlg5}Shadows swallow the alleys. Die! (Attack)</Text>
      <Consequences>
        <Action Type="KillHero" TargetAlias="Muhbir2" />
        <Action Type="SpawnBanditParty" TargetAlias="CeteMuhafizlari" Amount="30" PartyTemplateId="mercenary_template" StringValue="{=sp_gt2_thugs}Alley Enforcers" SpawnDistance="2" SpawnRadius="3" />
        <Action Type="SetPartyAi" TargetAlias="CeteMuhafizlari" StringValue="EngageParty" ObjectId="Player" />
        <Action Type="ChangeStage" ObjectId="Stage2_CeteSavasi" />
        <Action Type="LeaveEncounter" />
      </Consequences>
    </DialogNode>

    <DialogNode Type="Player" Id="GT2_M2_Choice_Ertele" TargetAlias="Muhbir2" InputToken="ql_gt2_m2_intro" OutputToken="close_window">
      <Text>{=sp_gt2_ertele}I cannot deal with this right now. We will speak later.</Text>
    </DialogNode>

    <!-- CETE SAVASI: MUHAFIZLAR ILE KARSILASMA DIYALOGU -->
    <DialogNode Type="Npc" Id="GT2_Muhafizlar_Giris" TargetAlias="CeteMuhafizlari" InputToken="start" OutputToken="ql_gt2_muhafizlar_choices" Priority="200">
      <Text>{=sp_gt2_dlg_thugs_intro}You butchered our boss in cold blood! None of you leave this street alive!</Text>
      <Conditions>
        <Condition Type="IsStageActive" ObjectId="Stage2_CeteSavasi" />
      </Conditions>
    </DialogNode>
    <DialogNode Type="Player" Id="GT2_Muhafizlar_P1" TargetAlias="CeteMuhafizlari" InputToken="ql_gt2_muhafizlar_choices" OutputToken="close_window">
      <Text>{=sp_gt2_dlg_thugs_p1}Your boss made his choice, and now you will join him! (Fight)</Text>
    </DialogNode>
    <DialogNode Type="Player" Id="GT2_Muhafizlar_P2" TargetAlias="CeteMuhafizlari" InputToken="ql_gt2_muhafizlar_choices" OutputToken="close_window">
      <Text>{=sp_gt2_dlg_thugs_p2}Clear the street or die where you stand! (Fight)</Text>
    </DialogNode>

    <!-- DOST ILE YUZLESME: 8 ADIMLI HESAPLASMA VE IKONIK DIALOG -->
    <DialogNode Type="Player" Id="GT2_Dost_Player" TargetAlias="Dost" InputToken="hero_main_options" OutputToken="ql_gt2_dost_a1" Priority="200">
      <Text>{=sp_gt2_dlg6_p}We meet again, {Dost_Name}. It seems our paths end here.</Text>
      <Conditions>
        <Condition Type="IsStageActive" ObjectId="Stage3_DostYuzlesme" />
      </Conditions>
    </DialogNode>

    <DialogNode Type="Npc" Id="GT2_Dost_Npc" TargetAlias="Dost" InputToken="start" OutputToken="ql_gt2_dost_step1_choices" Priority="200">
      <Text>{=sp_gt2_dlg6_intro}{PlayerName}... You stand before me with an army at your back. Did you think I wouldn't see the shadow of the Roost looming behind you?</Text>
      <Conditions>
        <Condition Type="IsStageActive" ObjectId="Stage3_DostYuzlesme" />
      </Conditions>
    </DialogNode>

    <DialogNode Type="Npc" Id="GT2_Dost_A1" TargetAlias="Dost" InputToken="ql_gt2_dost_a1" OutputToken="ql_gt2_dost_step1_choices">
      <Text>{=sp_gt2_dlg6_intro}{PlayerName}... You stand before me with an army at your back. Did you think I wouldn't see the shadow of the Roost looming behind you?</Text>
    </DialogNode>

    <!-- Tur 1: Oyuncu Tepkisi -->
    <DialogNode Type="Player" Id="GT2_D_P1_Inq" TargetAlias="Dost" InputToken="ql_gt2_dost_step1_choices" OutputToken="ql_gt2_dost_a2">
      <Text>{=sp_gt2_dlg_p1_inq}We were allies once, {Dost_Name}. I served you through four seasons. How long have you been playing both sides?</Text>
    </DialogNode>
    <DialogNode Type="Player" Id="GT2_D_P1_Direct" TargetAlias="Dost" InputToken="ql_gt2_dost_step1_choices" OutputToken="ql_gt2_dost_a2">
      <Text>{=sp_gt2_dlg_p1_direct}I know about the Black Ledger and the manufactured wars. Your web of lies has unraveled.</Text>
    </DialogNode>
    <DialogNode Type="Player" Id="GT2_D_P1_Prag" TargetAlias="Dost" InputToken="ql_gt2_dost_step1_choices" OutputToken="ql_gt2_dost_a2">
      <Text>{=sp_gt2_dlg_p1_prag}You brought an army to hunt me down. Is this how the Motherland treats its most loyal blade?</Text>
    </DialogNode>
    <DialogNode Type="Player" Id="GT2_D_P1_Ertele" TargetAlias="Dost" InputToken="ql_gt2_dost_step1_choices" OutputToken="close_window">
      <Text>{=sp_gt2_ertele}I cannot deal with this right now. We will speak later.</Text>
    </DialogNode>

    <!-- Tur 2: KULLANICI DIREKTIFINDEKI IKONIK REPLIK -->
    <DialogNode Type="Npc" Id="GT2_Dost_A2" TargetAlias="Dost" InputToken="ql_gt2_dost_a2" OutputToken="ql_gt2_dost_step2_choices">
      <Text>{=sp_gt2_dlg6_reply}Ever since you didn't kill that traitor, my eyes were upon you... You shall pay for your betrayal with your life!</Text>
    </DialogNode>

    <!-- Tur 3: Oyuncu Ihanetin Gercek Yuzunu Ortaya Koyar -->
    <DialogNode Type="Player" Id="GT2_D_P2_Truth" TargetAlias="Dost" InputToken="ql_gt2_dost_step2_choices" OutputToken="ql_gt2_dost_a3">
      <Text>{=sp_gt2_dlg_p2_truth}You call sparing a courier treason? Treason was setting Calradia on fire so your Pigeons could sell the ashes!</Text>
    </DialogNode>
    <DialogNode Type="Player" Id="GT2_D_P2_Accuse" TargetAlias="Dost" InputToken="ql_gt2_dost_step2_choices" OutputToken="ql_gt2_dost_a3">
      <Text>{=sp_gt2_dlg_p2_accuse}The courier showed me the orders you signed. You starved entire clans in winter and incited border raids in summer!</Text>
    </DialogNode>
    <DialogNode Type="Player" Id="GT2_D_P2_Ertele" TargetAlias="Dost" InputToken="ql_gt2_dost_step2_choices" OutputToken="close_window">
      <Text>{=sp_gt2_ertele}I cannot deal with this right now. We will speak later.</Text>
    </DialogNode>

    <!-- Tur 4: Devlet Aklini Savunur -->
    <DialogNode Type="Npc" Id="GT2_Dost_A3" TargetAlias="Dost" InputToken="ql_gt2_dost_a3" OutputToken="ql_gt2_dost_step3_choices">
      <Text>{=sp_gt2_dlg_dost_statecraft}You fool... You understand nothing of statecraft! Kings and emperors are arrogant toddlers who would drown Calradia in blood for sport. The Pigeons control the flow of wars so the realm survives in balance! Without our guided hand, chaos would swallow everything!</Text>
    </DialogNode>

    <!-- Tur 5: Oyuncunun Felsefi Karsi Cikisi -->
    <DialogNode Type="Player" Id="GT2_D_P3_Heroic" TargetAlias="Dost" InputToken="ql_gt2_dost_step3_choices" OutputToken="ql_gt2_dost_a4">
      <Text>{=sp_gt2_dlg_p3_heroic}Balance? You call slaughtering innocents balance?! You are not a protector, {Dost_Name}, you are a cancer on the Motherland.</Text>
    </DialogNode>
    <DialogNode Type="Player" Id="GT2_D_P3_Dark" TargetAlias="Dost" InputToken="ql_gt2_dost_step3_choices" OutputToken="ql_gt2_dost_a4">
      <Text>{=sp_gt2_dlg7}You are weak, {Dost_Name}. Your courts, your kings, and your lies only protect the weak. Pigeons do not soar in the skies, they feast above tombs.</Text>
    </DialogNode>
    <DialogNode Type="Player" Id="GT2_D_P3_Ertele" TargetAlias="Dost" InputToken="ql_gt2_dost_step3_choices" OutputToken="close_window">
      <Text>{=sp_gt2_ertele}I cannot deal with this right now. We will speak later.</Text>
    </DialogNode>

    <!-- Tur 6: Dost'un Savaşa Çağrısı -->
    <DialogNode Type="Npc" Id="GT2_Dost_A4" TargetAlias="Dost" InputToken="ql_gt2_dost_a4" OutputToken="ql_gt2_dost_final_choices">
      <Text>{=sp_gt2_dlg_dost_battlecry}Then words are finished. The Shadow Roost will fall with you today. Knights of the Motherland, draw your steel! Slay this traitor!</Text>
    </DialogNode>

    <!-- Tur 7: Savaşın Başlaması -->
    <DialogNode Type="Player" Id="GT2_Dost_Fight_Heroic" TargetAlias="Dost" InputToken="ql_gt2_dost_final_choices" OutputToken="close_window">
      <Text>{=sp_gt2_dlg7_heroic}For the true Calradia! Today the Motherland is freed from your poison! (Draw Steel &amp; Charge)</Text>
      <Consequences>
        <Action Type="DeclareWar" TargetAlias="Dost" />
        <Action Type="SetPartyAi" TargetAlias="DostOrdusu" StringValue="EngageParty" ObjectId="Player" />
      </Consequences>
    </DialogNode>
    <DialogNode Type="Player" Id="GT2_Dost_Fight_Dark" TargetAlias="Dost" InputToken="ql_gt2_dost_final_choices" OutputToken="close_window">
      <Text>{=sp_gt2_dlg7_dark}Draw your sword, puppet master! No cage will save you now! (Attack)</Text>
      <Consequences>
        <Action Type="DeclareWar" TargetAlias="Dost" />
        <Action Type="SetPartyAi" TargetAlias="DostOrdusu" StringValue="EngageParty" ObjectId="Player" />
      </Consequences>
    </DialogNode>
    <DialogNode Type="Player" Id="GT2_Dost_Choice_Ertele" TargetAlias="Dost" InputToken="ql_gt2_dost_final_choices" OutputToken="close_window">
      <Text>{=sp_gt2_ertele}I cannot deal with this right now. We will speak later.</Text>
    </DialogNode>
  </CustomDialogs>
</Questline>
